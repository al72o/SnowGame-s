# Файл подключается внутри http{} через /etc/nginx/conf.d/*.conf.
# Ограничиваем только страницу входа; AI endpoint после авторизации не throttling'уем.
limit_req_zone $binary_remote_addr zone=snowgame_login:10m rate=10r/m;

server {
    listen 80;
    listen [::]:80;
    server_name game.example.com;

    server_tokens off;
    client_max_body_size 512k;

    location = /healthz {
        return 404;
    }

    location = /login {
        limit_req zone=snowgame_login burst=10 nodelay;
        limit_req_status 429;

        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
