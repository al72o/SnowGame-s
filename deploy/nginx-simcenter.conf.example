# Full reference configuration based on the existing simcenter.partner.ru Nginx
# setup. It retains the existing upstream (127.0.0.1:5000), TLS
# certificate/key, and websocket headers. SnowGame lives exclusively under
# /snow/ on loopback port 3100.
#
# Do NOT overwrite the active Nginx file blindly. Back it up first, compare,
# then add only the three /snow location blocks inside the active HTTPS server.
# Refer to deploy/nginx-snow-path.conf.example and DEPLOY.md.

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    listen [::]:80;

    server_name simcenter.partner.ru 10.5.16.34 _;

    return 301 https://simcenter.partner.ru$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    server_name simcenter.partner.ru 10.5.16.34 _;

    ssl_certificate     /etc/ssl/simcenter/simcenter.partner.crt;
    ssl_certificate_key /etc/ssl/simcenter/simcenter.partner.key;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    client_max_body_size 160m;

    # Canonical trailing slash; otherwise relative web assets resolve wrongly.
    location = /snow {
        return 308 /snow/;
    }

    # Never expose the app's internal healthcheck on the public host.
    location = /snow/healthz {
        return 404;
    }

    location ^~ /snow/ {
        # Overrides the original 160m size limit only for the SnowGame app.
        client_max_body_size 512k;

        # Slash at the end strips /snow/ before forwarding.
        # Example: /snow/api/agent -> http://127.0.0.1:3100/api/agent
        proxy_pass http://127.0.0.1:3100/;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Prefix /snow;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_connect_timeout 15s;

        # Express generates Location: /snow/login and /snow/ after login.
        proxy_redirect off;
    }

    # Original project. Do not alter this block.
    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_connect_timeout 15s;
    }
}
