# Скопируйте этот файл в .env и заполните нужные значения.
# .env никогда не должен попасть в git (см. .gitignore) — там живут ключи.

# Порт, на котором поднимается сервер
PORT=3000

# Какой провайдер агента использовать: stub | openai | gigachat | yandexgpt
# stub — без AI, детерминированные правила из инструкции игры. Работает без ключей.
# openai — Chat Completions API (OpenAI или совместимый эндпоинт, см. OPENAI_BASE_URL)
# gigachat / yandexgpt — заготовки, ещё не реализованы (см. server/providers/*.js)
AGENT_PROVIDER=stub

# --- нужно только если AGENT_PROVIDER=openai ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Смените, если используете не api.openai.com, а совместимый эндпоинт
# (свой сервер, OpenRouter, локальная модель через vLLM/Ollama и т.п.)
OPENAI_BASE_URL=https://api.openai.com/v1
