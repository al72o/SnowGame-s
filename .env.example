# Скопируйте этот файл в .env и заполните значения.
# .env содержит секреты и не должен попадать в git.

# Домен без https://. Используется в документации/операционных настройках.
DOMAIN=game.example.com

# Приложение внутри Docker.
HOST=0.0.0.0
PORT=3000
# Порт на host loopback. Можно поменять, если 3000 занят другим сервисом.
APP_BIND_PORT=3000
NODE_ENV=production

# --- Авторизация ---
# В production оставляйте true.
AUTH_ENABLED=true
AUTH_USERNAME=admin
AUTH_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
# Минимум 32 случайных символа. Например: openssl rand -hex 32
AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
AUTH_SESSION_HOURS=12
# Для HTTPS через Nginx оставляйте true.
AUTH_COOKIE_SECURE=true

# Защита формы входа: не более 10 попыток с IP за 15 минут.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

# Провайдер агента: stub | openai | litellm | gigachat | yandexgpt
# litellm использует тот же OpenAI-compatible transport и существующие промпты.
AGENT_PROVIDER=litellm

# --- OpenAI-compatible API ---
OPENAI_API_KEY=
OPENAI_MODEL=qwen3.8-flash-next
OPENAI_BASE_URL=https://litellm.dns-shop.ru/v1

# Таймаут одного обращения к модели.
OPENAI_REQUEST_TIMEOUT_MS=90000

# response_format для JSON-задач:
# auto = использовать и автоматически повторить без него при 400/422;
# on   = всегда использовать;
# off  = не использовать.
OPENAI_JSON_MODE=auto

# omit = не отправлять параметр temperature для моделей, которые его не поддерживают.
OPENAI_TEMPERATURE=omit

# Дополнительный лимит публичного AI endpoint на один авторизованный IP.
AGENT_RATE_LIMIT_WINDOW_MS=60000
AGENT_RATE_LIMIT_MAX=60

# Nginx на этом же хосте — один доверенный reverse-proxy hop.
TRUST_PROXY_HOPS=1
